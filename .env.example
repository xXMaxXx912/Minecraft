# Basis-URL eines OpenAI-kompatiblen Chat-APIs (ohne /chat/completions)
# Beispiele:
#   OpenRouter:  https://openrouter.ai/api/v1
#   OpenAI:      https://api.openai.com/v1
#   Ollama:      http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=dein-api-key
LLM_MODEL=modell-name

# Geheimer Schlüssel zum Signieren des Alters-Cookies (lange Zufallszeichenkette!)
SESSION_SECRET=bitte-aendern

PORT=3000

# Ordner für Konten und eigene Figuren (Standard: ./data)
# DATA_DIR=./data
