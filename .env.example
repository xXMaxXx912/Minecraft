# Basis-URL eines OpenAI-kompatiblen Chat-APIs (ohne /chat/completions)
# Beispiele:
#   xAI (Grok):  https://api.x.ai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   OpenAI:      https://api.openai.com/v1
#   Ollama:      http://localhost:11434/v1
LLM_BASE_URL=https://api.x.ai/v1
# Key von https://console.x.ai → API Keys
LLM_API_KEY=ac0dfda5-b9f9-4730-8295-aeae245a996c
# Modellname aus der xAI-Konsole (Bereich "Models"), z. B. ein aktuelles grok-Modell
LLM_MODEL=grok-4.7

# Geheimer Schlüssel zum Signieren der Sitzungs-Cookies (lange Zufallszeichenkette!)
SESSION_SECRET=40855314004130e81ef14db3bfc5974b8ce4483824f03313c73ee66f401bd19c

PORT=3000

# Ordner für Konten und eigene Figuren (Standard: ./data)
# DATA_DIR=./data

# Hinter einem HTTPS-Reverse-Proxy auf 1 setzen
# TRUST_PROXY=1
